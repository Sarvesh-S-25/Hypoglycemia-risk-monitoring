# Data source: simulator (default, no hardware needed) | ble | auto (try ble, fall back to simulator)
GS_SOURCE=simulator

# SQLite file path, relative to backend/ or absolute
GS_DB_PATH=./data/glucosentry.db

# Expose POST /api/sim/* endpoints (start/stop/spike) for demo and induced-signal testing
GS_ENABLE_SIM=1

# Path to your trained risk model, exported to ONNX. Empty string -> StubRiskModel
# (a heuristic placeholder, no ML dependency required). Two ways to use your
# own model -- pick whichever is more convenient:
#
#   A) Through the UI (recommended, no restart needed): open the dashboard,
#      click "Model", and upload the .onnx file there. It's applied
#      immediately and the choice is remembered across restarts.
#
#   B) Through this file: export your model with torch.onnx.export(...), drop
#      the .onnx file under backend/, e.g. backend/models/risk_model.onnx, set
#      this to that path (GS_MODEL_PATH=./models/risk_model.onnx), and restart
#      the backend. A selection made through the UI takes priority over this
#      value if both are set.
#
# Either way, GET /api/status and the dashboard's Device Status panel show
# "ONNX: risk_model.onnx" once it's loaded -- or the failure reason instead of
# silently staying on the stub, if it couldn't be loaded. See
# docs/API_CONTRACT.md's "Model management" section and app/inference.py for
# the exact input shape (1, 1, N) float32 this expects.
GS_MODEL_PATH=

# Where uploaded models are stored (used by the Model page's upload/select)
GS_MODELS_DIR=./models

# Where the current model selection is persisted across restarts
GS_MODEL_SELECTION_PATH=./data/model_selection.txt

# Maximum accepted upload size in megabytes for POST /api/model/upload
GS_MAX_MODEL_UPLOAD_MB=200

# CORS origin for the Vite dev server
GS_CORS_ORIGIN=http://localhost:5173

# BLE scan timeout in seconds before GS_SOURCE=auto falls back to the simulator
GS_BLE_SCAN_TIMEOUT_S=8
