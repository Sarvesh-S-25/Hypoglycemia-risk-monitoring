# Python
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/.pytest_cache/

# Backend data (local SQLite, never committed -- SRD requires local-only storage)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
# Per-machine model choice and uploaded models (share .onnx files separately)
backend/data/model_selection.txt
backend/models/*.onnx

# Env files (committed as .env.example instead)
backend/.env
frontend/.env

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Editor / OS
.DS_Store
Thumbs.db
*.log

# PlatformIO build output
firmware/**/.pio/
